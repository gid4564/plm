# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public base URL of this PLM instance. Must be the HTTPS URL Onshape can reach:
# the webhook callback, the OAuth redirect, the extension action URLs and the
# right-panel iframe all resolve against it.
#
# This is the setting most often got wrong. If it is not https:// the session
# cookie cannot be issued SameSite=None, and the Onshape panel then appears
# permanently signed out.
#
# Deployed:  APP_BASE_URL=https://plm.gidpaull.com
#            (the reverse proxy terminates TLS and forwards to port 3005 — this
#             is the address Onshape resolves, never the local port)
APP_BASE_URL=http://localhost:3011

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-32-byte-hex-string

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local dev: npm run db:start. Safe to share a mongod with another app — PLM
# only needs its own database, and db:start says so rather than failing if one
# is already listening.
MONGODB_URI=mongodb://127.0.0.1:27017
# Deployed server (Atlas): whitelist THAT server's IP, not your laptop's.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=plm

# ---------------------------------------------------------------------------
# Onshape mode: "mock" runs the built-in simulator, "live" hits the real API.
#
# Mock mode simulates the whole release lifecycle — release packages, workflow
# transitions, revision creation and drawing PDFs — so the integration can be
# demonstrated end to end with no Onshape enterprise at all.
# ---------------------------------------------------------------------------
ONSHAPE_MODE=mock

# ---------------------------------------------------------------------------
# PLM as an OAuth *client* of Onshape (only required when ONSHAPE_MODE=live).
#
# This is how PLM reads and writes Onshape. From the Onshape Dev Portal.
# ---------------------------------------------------------------------------
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
ONSHAPE_OAUTH_URL=https://oauth.onshape.com
ONSHAPE_API_URL=https://cad.onshape.com/api

# ---------------------------------------------------------------------------
# PLM as an OAuth *server* to Onshape
#
# Onshape's extension action URLs use External OAuth: Onshape is the client and
# PLM is the authorization server. There is nothing to configure here — the
# client id and secret are generated in Settings and pasted into the Dev Portal,
# and only their hashes are stored. Listed only so the two directions are not
# confused: the block above is PLM calling Onshape, this is Onshape calling PLM.
# ---------------------------------------------------------------------------

# Shared secret for the webhook callback URL.
#
# Webhooks are the one inbound path that cannot use a bearer token: Onshape's
# webhook registration accepts no custom headers and offers no signature
# scheme, so the secret rides in the registered callback URL. Set this and
# re-register the webhook in Settings.
ONSHAPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Onshape API paths
#
# Overridable because several of these are poorly documented and have differed
# between tenants. A wrong value fails the one feature that uses it and leaves
# everything else working.
# ---------------------------------------------------------------------------
# Enumerating enterprise custom-property definitions.
ONSHAPE_METADATA_SCHEMA_PATH=/metadataschema
# Rendering (shaded views), used for thumbnails. Degrades to a placeholder.
#
# Two paths, because a part and an assembly are addressed differently: the part
# endpoint names a partId, and an assembly has none.
ONSHAPE_SHADEDVIEWS_PATH=/parts
ONSHAPE_ASSEMBLY_SHADEDVIEWS_PATH=/assemblies
# Reading an assembly's bill of materials, used by Import from Assembly.
ONSHAPE_BOM_PATH=/assemblies
# Part export: the first serves formats Onshape hands back directly (STL,
# Parasolid); the second submits translation jobs (STEP, IGES, 3MF).
# An assembly cannot be exported directly and always goes through translation,
# from its own endpoint rather than the Part Studio's.
ONSHAPE_PARTS_PATH=/parts
ONSHAPE_TRANSLATIONS_PATH=/partstudios
ONSHAPE_ASSEMBLY_TRANSLATIONS_PATH=/assemblies
# Mass properties, read on demand on the part page. An assembly's are rolled up
# by Onshape from its components, and read from the assembly endpoint.
ONSHAPE_MASSPROPERTIES_PATH=/partstudios
ONSHAPE_ASSEMBLY_MASSPROPERTIES_PATH=/assemblies
# Drawing PDF export. Used twice per release — once at submission and once
# after it completes, when the sheet carries its revision and watermark.
ONSHAPE_DRAWINGS_PATH=/drawings
# Tasks, and the comments on them.
ONSHAPE_TASKS_PATH=/tasks
ONSHAPE_COMMENTS_PATH=/comments
# The numeric object-type code a comment on a TASK uses.
#
# Mandatory on the wire — Onshape answers a bare 404 "Not found." without it —
# but its values are not declared anywhere. PLM prefers the code off an
# existing comment on the same task, and otherwise uses TASK's ordinal in
# Onshape's declared BTMetadataObjectType enum, which is 14. That ordinal is an
# inference from the enum's ordering, so this override exists in case it is
# wrong on your tenant.
# ONSHAPE_COMMENT_OBJECT_TYPE_TASK=14

# ---------------------------------------------------------------------------
# Collecting the released drawing sheets
# ---------------------------------------------------------------------------
# Onshape announces new revisions BEFORE it has finished applying them to the
# drawings, so PLM's first attempt at collecting the released sheets is usually
# too early. These are the waits before each attempt, in milliseconds; PLM stops
# as soon as the sheets are in. The default covers about 18 minutes.
#
# Raise it if released sheets still need collecting by hand on this tenant —
# large drawings and busy tenants both take longer. Read on each use, so a
# change needs a restart only to reload the file, not a rebuild.
# PLM_DRAWING_REFRESH_RETRIES_MS=15000,45000,120000,300000,600000
