# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public base URL of this MOS instance. Must be the HTTPS URL Onshape can reach
# (webhook callbacks + the right-panel iframe both resolve against it).
APP_BASE_URL=http://localhost:3000

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-32-byte-hex-string

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local dev: npm run db:start
MONGODB_URI=mongodb://127.0.0.1:27017
# Deployed server (Atlas): whitelist THAT server's IP, not your laptop's.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mos

# ---------------------------------------------------------------------------
# Onshape mode: "mock" runs the built-in simulator, "live" hits the real API.
# ---------------------------------------------------------------------------
ONSHAPE_MODE=mock

# Only required when ONSHAPE_MODE=live. From the Onshape Dev Portal.
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=
ONSHAPE_OAUTH_URL=https://oauth.onshape.com
ONSHAPE_API_URL=https://cad.onshape.com/api
# Shared secret you set on the webhook registration; used to verify callbacks.
ONSHAPE_WEBHOOK_SECRET=

# Optional shared secret for the Part Numbering app extension endpoint
# (/api/numbering/onshape-extension). That extension's Action URL does not
# support placeholders, so append it as a query string when registering the
# URL in the Developer Portal, e.g. .../onshape-extension?token=<this value>.
# Leave unset to accept calls with no token, e.g. for local testing.
ONSHAPE_NUMBERING_SECRET=

# Endpoint used to enumerate enterprise custom-property definitions.
# Documented poorly by Onshape; override here if your tenant differs.
ONSHAPE_METADATA_SCHEMA_PATH=/metadataschema

# Base path for part rendering (shaded views), used for thumbnails. Override if
# your tenant differs. Thumbnails degrade to a placeholder if this is wrong —
# nothing else breaks.
ONSHAPE_SHADEDVIEWS_PATH=/parts

# Base path for reading an assembly's bill of materials, used by Import from
# Assembly. Override if your tenant differs. If it is wrong, importing reports
# the error and the rest of the MOS is unaffected.
ONSHAPE_BOM_PATH=/assemblies

# Base paths used by "Export the part". The first serves formats Onshape hands
# back directly (STL, Parasolid); the second submits translation jobs (STEP,
# IGES, 3MF). Override if your tenant differs — a wrong value fails the export
# with Onshape's own message and affects nothing else.
ONSHAPE_PARTS_PATH=/parts
ONSHAPE_TRANSLATIONS_PATH=/partstudios

# Base path for mass-properties reads, used on the item page. Override if your
# tenant differs — a wrong value fails that one read and affects nothing else.
ONSHAPE_MASSPROPERTIES_PATH=/partstudios
